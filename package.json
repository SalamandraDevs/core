{
  "name": "@slmdevs/core",
  "version": "0.1.0",
  "description": "Shared entity and database contracts",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf ./dist ./types ./tsconfig.tsbuildinfo",
    "check": "tsc --noEmit",
    "lint": "eslint ./src --ext .ts --fix",
    "format": "prettier --config .prettierrc ./src --write"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run format && pnpm run lint"
  },
  "license": "LGPL-3.0-or-later",
  "files": [
    "dist",
    "types"
  ],
  "dependencies": {
    "@slmdevs/tools": "file:../tools",
    "mongodb": "^7.6.0",
    "mysql2": "^3.23.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
